# Used by docker-compose.yml (production-like stack). For local development see apps/api/.env.example.
POSTGRES_USER=thataway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thataway

# Wikimedia asks every client to say who it is and how to reach it
WIKIMEDIA_CONTACT=you@example.com
LOG_LEVEL=info\n# Where clients reach the API; art URLs are built on it\nPUBLIC_URL=http://localhost:3040\n