# The API the worker takes jobs from and hands pictures to
API_URL=https://thataway.nezdemkovski.cloud
# The token from the `thataway` item in 1Password (ART_WORKER_TOKEN)
ART_WORKER_TOKEN=
# Wikimedia asks every client to say who it is and how to reach it
WIKIMEDIA_CONTACT=https://github.com/nezdemkovski/thataway
# The mflux and rembg command-line tools (uv tool install mflux / "rembg[cli,cpu]")
MFLUX_EDIT_BIN=/Users/yuri/.local/bin/mflux-generate-qwen-2.1-edit
REMBG_BIN=/Users/yuri/.local/bin/rembg
# Python with Pillow and numpy for the cut-out step (rembg's own environment has both)
PYTHON_BIN=/Users/yuri/.local/share/uv/tools/rembg/bin/python
# Where pictures are drawn before they are handed in
WORK_DIR=/tmp/thataway-art
# Seconds to wait when the queue is empty
IDLE_SECONDS=60
