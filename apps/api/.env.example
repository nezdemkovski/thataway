NODE_ENV=development
PORT=3040
# Matches docker-compose.dev.yml (`bun run db:up`)
POSTGRES_URL=postgresql://thataway:thataway@localhost:5433/thataway
# Wikimedia's policy: every client names itself and gives a way to reach its owner
WIKIMEDIA_CONTACT=you@example.com
LOG_LEVEL=info
# Illustrations live in an S3 bucket (docker-compose.dev.yml runs RustFS on 9000; the bucket
# and its public-read policy are created on start). Leave S3_ENDPOINT empty to run without art.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thataway-art
S3_ACCESS_KEY=thataway
S3_SECRET_KEY=thataway-dev
# Where the bucket is reachable by the app (the tunnel path in the homelab)
ART_PUBLIC_BASE_URL=http://localhost:9000/thataway-art
# Bearer token the art worker on the Mac presents to /art/jobs/*
ART_WORKER_TOKEN=dev-worker-token
